{
  "name": "Exam",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "num_questions": {
      "type": "number"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          }
        }
      }
    },
    "score": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed"
      ],
      "default": "draft"
    }
  },
  "required": [
    "title",
    "questions"
  ]
}