{
  "name": "PracticeSession",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "default": "medium"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          }
        }
      }
    },
    "score": {
      "type": "number"
    },
    "total": {
      "type": "number"
    }
  },
  "required": [
    "topic",
    "questions"
  ]
}