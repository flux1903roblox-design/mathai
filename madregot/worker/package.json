{
  "name": "madregot-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply madregot --remote",
    "db:migrate:local": "wrangler d1 migrations apply madregot --local",
    "db:init": "npm run db:migrate",
    "owner": "node scripts/owner.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0"
  },
  "devDependencies": {
    "wrangler": "4.151.3"
  }
}
