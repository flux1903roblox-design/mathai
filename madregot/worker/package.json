{
  "name": "madregot-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply madregot --remote",
    "db:migrate:local": "wrangler d1 migrations apply madregot --local",
    "db:init": "npm run db:migrate",
    "staging:migrate": "wrangler d1 migrations apply madregot-staging --env staging --remote",
    "staging:deploy": "wrangler deploy --env staging",
    "owner": "node scripts/owner.mjs",
    "eval:tutor": "node eval/run.mjs",
    "eval:estimate": "node eval/run.mjs --estimate",
    "push:keys": "node scripts/push-keys.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0"
  },
  "devDependencies": {
    "wrangler": "4.151.3"
  }
}
