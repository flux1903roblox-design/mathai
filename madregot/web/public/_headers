# script-src 'wasm-unsafe-eval': a scanned PDF page is often a JPEG 2000 picture, which pdf.js decodes with WebAssembly
# (src/lib/pdfPages.js, PKG-2). It allows compiling WebAssembly only; JavaScript eval stays forbidden (no 'unsafe-eval').
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()

# the web app manifest (DURABLE-3); browsers accept application/json too, and GitHub Pages ignores this file
/manifest.webmanifest
  Content-Type: application/manifest+json

# the offline service worker (DURABLE-10): always checked for a new release; the hashed assets never change
/sw.js
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/l/*
  Cache-Control: public, max-age=86400
