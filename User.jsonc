      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d4\u05d7\u05d9\u05e0\u05de\u05d9\u05d5\u05ea \u05e9\u05e0\u05d5\u05ea\u05e8\u05d5 \u05dc\u05de\u05e9\u05ea\u05de\u05e9",
      "default": 5
    },
    "subscription_plan": {
